# AnuranCall does not read .env files itself — export these in your shell, or
# pass the equivalent flag on the command line. Both lines are safe low-risk
# defaults: the tool runs with no environment at all.
#
# Path to the JSON session store (default: ~/.anurancall/sessions.json).
# --data PATH on the command line wins over this value.
ANURANCALL_DATA=
# Set to any non-empty value to disable ANSI colour (same as --no-color).
NO_COLOR=
